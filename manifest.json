{
  "name": "文本分享工具",
  "short_name": "TextShare",
  "description": "安全、私密、便捷的文本分享工具，支持阅后即焚、过期销毁",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#3b82f6",
